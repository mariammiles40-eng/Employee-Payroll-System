        displayMenu();
        printf("Enter your choice: ");
        scanf("%d", &choice);
        clearBuffer();
        switch (choice) {
            case 1: registerEmployee();    break;
            case 2: searchEmployee();      break;
            case 3: updateEmployee();      break;
            case 4: deleteEmployee();      break;
            case 5: calculateAllSalaries(); break;
            case 6: displayPayrollReport(); break;
