    printf("  Gross Pay       : UGX %.2f\n", emp->grossPay);
    printDivider('-', 50);
    printf("  Tax (30%%)       : UGX %.2f\n", emp->taxAmount);
    printf("  NSSF (5%%)       : UGX %.2f\n", emp->nssfAmount);
