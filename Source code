void registerEmployee(void) {
    if (empCount >= MAX_EMPLOYEES) {
        printf("\nERROR: Employee list is full (%d max).\n",
               MAX_EMPLOYEES);
        return;
    }
    Employee *e = &employees[empCount];
    printf("\n--- Register New Employee ---\n");
    e->empID = ID_BASE + empCount;
    printf("Full Name        : ");
    fgets(e->name, sizeof(e->name), stdin);
    /* Remove trailing newline */
    e->name[strcspn(e->name, "\n")] = '\0';
    printf("Department       : ");
    fgets(e->department, sizeof(e->department), stdin);
    e->department[strcspn(e->department, "\n")] = '\0';
    printf("Hourly Rate (UGX): ");
    scanf("%f", &e->hourlyRate);
    clearBuffer();
    printf("Hours Worked     : ");
    scanf("%f", &e->hoursWorked);
    clearBuffer();
    /*  Input validation  */
    if (e->hourlyRate < 0) {
        printf("ERROR: Hourly rate cannot be negative. "
               "Employee not registered.\n");
        return;
    }
    if (e->hoursWorked < 0) {
        printf("ERROR: Hours worked cannot be negative. "
               "Employee not registered.\n");
        return;
    }
    /* Compute salary immediately on registration */
    calculateSalary(e);
    empCount++;
    printf("\nEmployee registered successfully!\n");
    printf("Assigned Employee ID : %d\n", e->empID);
    printf("Net Pay this month   : UGX %.2f\n", e->netPay);
}
void searchEmployee(void) {
    int  choice, id, idx;
    char nameQuery[60];
    printf("\n--- Search Employee ---\n");
    printf("Search by:\n  1. Employee Name\n  2. Employee ID\n");
    printf("Choice: ");
    scanf("%d", &choice);
    clearBuffer();
    if (choice == 1) {
        printf("Enter name to search: ");
        fgets(nameQuery, sizeof(nameQuery), stdin);
        nameQuery[strcspn(nameQuery, "\n")] = '\0';
        idx = findByName(nameQuery);
        if (idx == -1) {
            printf("\nNo employee found with name containing '%s'.\n",
                   nameQuery);
        } else {
               printf("\nEmployee found:\n");
            displayEmployee(&employees[idx]);
        }
    } else if (choice == 2) {
        printf("Enter Employee ID: ");
        scanf("%d", &id);
        clearBuffer();
        idx = findByID(id);
        if (idx == -1) {
            printf("\nNo employee found with ID %d.\n", id);
        } else {
            printf("\nEmployee found:\n");
            displayEmployee(&employees[idx]);
        }
    } else {
        printf("Invalid choice.\n");
    }
}
void updateEmployee(void) {
    int  id, idx, field;
    char newDept[40];
    float newRate, newHours;
    printf("\n--- Update Employee ---\n");
    printf("Enter Employee ID to update: ");
    scanf("%d", &id);
    clearBuffer();
    idx = findByID(id);
    if (idx == -1) {
        printf("ERROR: Employee with ID %d not found.\n", id);
        return;
    }
    printf("\nUpdating: %s (ID: %d)\n",
           employees[idx].name, employees[idx].empID);
    printf("What would you like to update?\n");
    printf("  1. Hourly Rate\n");
    printf("  2. Hours Worked\n");
    printf("  3. Department\n");
    printf("  4. Update All Fields\n");
    printf("Choice: ");
    scanf("%d", &field);
    clearBuffer();
    switch (field) {
        case 1:
            printf("New Hourly Rate (UGX): ");
            scanf("%f", &newRate);
            clearBuffer();
            if (newRate < 0) {
                printf("ERROR: Hourly rate cannot be negative.\n");
                return;
            }
            employees[idx].hourlyRate = newRate;
            break;
         case 2:
            printf("New Hours Worked: ");
            scanf("%f", &newHours);
            clearBuffer();
            if (newHours < 0) {
                printf("ERROR: Hours worked cannot be negative.\n");
                return;
            }
            employees[idx].hoursWorked = newHours;
            break;
        case 3:
            printf("New Department: ");
            fgets(newDept, sizeof(newDept), stdin);
            newDept[strcspn(newDept, "\n")] = '\0';
            strcpy(employees[idx].department, newDept);
            break;
        case 4:
            printf("New Hourly Rate (UGX): ");
            scanf("%f", &newRate);
            clearBuffer();
            printf("New Hours Worked    : ");
            scanf("%f", &newHours);
            clearBuffer();
            printf("New Department      : ");
            fgets(newDept, sizeof(newDept), stdin);
            newDept[strcspn(newDept, "\n")] = '\0';
            if (newRate < 0 || newHours < 0) {
                printf("ERROR: Negative values are not allowed.\n");
                return;
            }
            employees[idx].hourlyRate  = newRate;
            employees[idx].hoursWorked = newHours;
            strcpy(employees[idx].department, newDept);
            break;
        default:
            printf("Invalid choice. No changes made.\n");
            return;
    }
    /* Recalculate salary after any update */
    calculateSalary(&employees[idx]);
    printf("\nEmployee updated successfully.\n");
    printf("Recalculated Net Pay : UGX %.2f\n", employees[idx].netPay);
}
void deleteEmployee(void) {
    int  id, idx;
    char confirm;
    printf("\n--- Delete Employee ---\n");
    printf("Enter Employee ID to delete: ");
    scanf("%d", &id);
    clearBuffer();
      idx = findByID(id);
    if (idx == -1) {
        printf("ERROR: Employee with ID %d not found.\n", id);
        return;
    }
    printf("\nAre you sure you want to delete '%s' (ID: %d)? (y/n): ",
           employees[idx].name, id);
    scanf("%c", &confirm);
    clearBuffer();
    if (tolower(confirm) != 'y') {
        printf("Deletion cancelled.\n");
        return;
    }
    /* Shift all records after idx one position left */
    for (int i = idx; i < empCount - 1; i++) {
        employees[i] = employees[i + 1];
    }
    empCount--;
    printf("Employee (ID: %d) deleted successfully.\n", id);
    printf("Total employees remaining: %d\n", empCount);
}
void calculateSalary(Employee *emp) {
    /*  Input guard  */
    if (emp->hourlyRate < 0 || emp->hoursWorked < 0) {
        printf("ERROR: Cannot calculate salary – negative value detected.\n");
        return;
    }
    /*  Step 1 & 2: Normal pay and overtime pay  */
    if (emp->hoursWorked <= NORMAL_HOURS) {
        emp->normalPay   = emp->hoursWorked * emp->hourlyRate;
        emp->overtimePay = 0.0f;
        emp->overtimeFlag = 0;
    } else {
        emp->normalPay   = NORMAL_HOURS * emp->hourlyRate;
        emp->overtimePay = (emp->hoursWorked - NORMAL_HOURS)
                           * emp->hourlyRate * OT_MULTIPLIER;
        emp->overtimeFlag = 1;
    }
    /*  Excessive hours check  */
    if (emp->hoursWorked > EXCESSIVE_HOURS) {
        emp->excessiveFlag = 1;
        printf("\n  !! WARNING: %s has worked %.0f hours this month,\n"
               "             which exceeds the safe limit of %.0f hours.\n"
               "             Please review this record.\n",
               emp->name, emp->hoursWorked, EXCESSIVE_HOURS);
    } else {
        emp->excessiveFlag = 0;
    }
    /*  Step 3: Gross pay  */
       emp->grossPay = emp->normalPay + emp->overtimePay;
    /*  Step 4-6: Deductions  */
    emp->taxAmount    = emp->grossPay * TAX_RATE;
    emp->nssfAmount   = emp->grossPay * NSSF_RATE;
    emp->healthAmount = emp->grossPay * HEALTH_RATE;
    /*  Step 7: Total deductions  */
    emp->totalDeductions = emp->taxAmount
                         + emp->nssfAmount
                         + emp->healthAmount;
    /*  Step 8: Net pay  */
    emp->netPay = emp->grossPay - emp->totalDeductions;
}
void calculateAllSalaries(void) {
    if (empCount == 0) {
        printf("\nNo employees registered yet.\n");
        return;
    }
    printf("\nCalculating salaries for all %d employee(s)...\n", empCount);
    for (int i = 0; i < empCount; i++) {
        calculateSalary(&employees[i]);
    }
    printf("All salaries calculated successfully.\n");
}
void displayPayrollReport(void) {
    if (empCount == 0) {
        printf("\nNo employee records to display.\n");
        return;
    }
    float totalGross    = 0.0f;
    float totalDeduct   = 0.0f;
    float totalNet      = 0.0f;
    int   topIdx        = 0;
    int   overtimeCount = 0;
    int   excessCount   = 0;
    printf("\n");
    printDivider('=', 78);
    printf("  EMPLOYEE PAYROLL REPORT\n");
    printDivider('=', 78);
    /* Table header */
    printf("%-6s %-20s %-12s %9s %9s %9s %9s  %s\n",
           "ID", "Name", "Dept", "Gross", "Deduct",
           "Net Pay", "Hours", "Flag");
    printDivider('-', 78);
    for (int i = 0; i < empCount; i++) {
             Employee *e = &employees[i];
        /* Determine flag label */
        char flag[16] = "";
        if (e->excessiveFlag)  strcpy(flag, "!! EXCESS");
        else if (e->overtimeFlag) strcpy(flag, "OT");
        /* Truncate long names for table alignment */
        char shortName[21];
        strncpy(shortName, e->name, 20);
        shortName[20] = '\0';
        char shortDept[13];
        strncpy(shortDept, e->department, 12);
        shortDept[12] = '\0';
        printf("%-6d %-20s %-12s %9.0f %9.0f %9.0f %9.0f  %s\n",
               e->empID, shortName, shortDept,
               e->grossPay, e->totalDeductions,
               e->netPay, e->hoursWorked, flag);
        /* Running totals */
        totalGross  += e->grossPay;
        totalDeduct += e->totalDeductions;
        totalNet    += e->netPay;
        if (e->overtimeFlag)  overtimeCount++;
        if (e->excessiveFlag) excessCount++;
        /* Track highest-paid */
        if (e->netPay > employees[topIdx].netPay) topIdx = i;
    }
    printDivider('-', 78);
    /* Totals row */
    printf("%-6s %-20s %-12s %9.0f %9.0f %9.0f\n",
           "TOTAL", "", "", totalGross, totalDeduct, totalNet);
    printDivider('=', 78);
    /* Summary section */
    printf("\n  PAYROLL SUMMARY\n");
    printDivider('-', 45);
    printf("  Total Employees        : %d\n", empCount);
    printf("  Employees on Overtime  : %d\n", overtimeCount);
    printf("  Excessive Hours Flags  : %d\n", excessCount);
    printf("  Total Gross Payroll    : UGX %12.2f\n", totalGross);
    printf("  Total Deductions       : UGX %12.2f\n", totalDeduct);
    printf("  Total Net Payroll      : UGX %12.2f\n", totalNet);
    printDivider('-', 45);
    printf("  * HIGHEST-PAID EMPLOYEE *\n");
    printf("  Name   : %s\n",   employees[topIdx].name);
    printf("  ID     : %d\n",   employees[topIdx].empID);
    printf("  Dept   : %s\n",   employees[topIdx].department);
    printf("  Net Pay: UGX %.2f\n", employees[topIdx].netPay);
    printDivider('=', 78);
    /* Deductions breakdown notice */
    printf("\n  Deduction Rates Applied:\n");
    printf("    Income Tax      : %.0f%% of Gross Pay\n", TAX_RATE*100);
    printf("    NSSF            : %.0f%% of Gross Pay\n", NSSF_RATE*100);
      printf("    Health Insurance: %.0f%% of Gross Pay\n", HEALTH_RATE*100);
    printf("    Overtime Rate   : %.1fx Base Hourly Rate\n", OT_MULTIPLIER);
    printf("    Normal Hours Cap: %.0f hours/month\n", NORMAL_HOURS);
    printDivider('=', 78);
}
