        printf("  [!! Excessive hours – please review]\n");
    printDivider('-', 50);
}
int findByID(int id) {
    for (int i = 0; i < empCount; i++) {
        if (employees[i].empID == id) return i;
    }
    return -1;
}
int findByName(const char *query) {
    char lQuery[60], lName[60];
    toLowerCase((char *)query, lQuery);
    for (int i = 0; i < empCount; i++) {
        toLowerCase(employees[i].name, lName);
        if (strstr(lName, lQuery) != NULL) return i;
    }
    return -1;
}
void clearBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}
void toLowerCase(char *str, char *out) {
    int i;
    for (i = 0; str[i] != '\0'; i++)
        out[i] = (char)tolower((unsigned char)str[i]);
    out[i] = '\0';
}
void printDivider(char ch, int len) {
    for (int i = 0; i < len; i++) putchar(ch);
    putchar('\n');
}
